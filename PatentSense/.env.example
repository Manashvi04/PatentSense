# Express API
NODE_ENV=development
API_PORT=5000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DATABASE_PATH=server/patentsense.db
APP_BASE_URL=http://localhost:5173

# Password reset email (Resend); required when NODE_ENV=production
RESEND_API_KEY=
PASSWORD_RESET_EMAIL_FROM=PatentSense <security@example.com>

# After registering a trusted operator account, explicitly grant admin access:
# npm run admin:promote -- operator@example.com

# Flask similarity service
AI_PORT=5001
FLASK_URL=http://127.0.0.1:5001
# Optional model stack: install ai_service/requirements-ml.txt
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
MIN_SIMILARITY=0.25
AI_REQUEST_TIMEOUT_MS=120000

# Vite development proxy
API_PROXY_TARGET=http://127.0.0.1:5000
